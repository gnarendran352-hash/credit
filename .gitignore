# ============================================
# Root .gitignore for Credit Card Fraud Detection
# ============================================

# --- Node.js / Vite ---
node_modules/
.vite/
dist/
dist-ssr/
*.local
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# --- Environment Variables ---
# Ignore all .env files except those explicitly tracked
.env
.env.local
.env.*.local

# --- Model Files ---
# NOTE: Model file is required for production deployment on Render
# credit_card_fraud_model.pkl

# --- Large Dataset Files ---
# CSV dataset exceeds GitHub's 100MB limit; keep local only
creditcard_2023.csv
# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Coverage ---
coverage/
.nyc_coverage/
.coverage
htmlcov/

# --- OS / Editor ---
*.swp
*.swo
*~
.Sw*
